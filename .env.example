# Reference values only. The Tide React SDK reads its config from the adapter JSON
# (public/tidecloak.json, exported from your realm) — NOT from env vars.
# Never commit a filled-in .env or your real tidecloak.json (both are git-ignored).
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=your-realm
TIDECLOAK_CLIENT_ID=your-client

